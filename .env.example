# Copiar a apps/web/.env.local (Next.js) y completar. Nunca commitear valores reales.
# packages/db lee DATABASE_URL del entorno para migraciones.
# Base de la instalación (Neon). En Lab y pruebas, siempre una rama de Neon dedicada.
DATABASE_URL="postgresql://usuario:clave@host/db?sslmode=require"

# Ruta (relativa a la raíz del repo) al client.config.json de esta instalación.
# Por defecto ./client.config.json. En desarrollo podés usar client.config.example.json.
CLUMERA_CLIENT_CONFIG=""

# Licencia firmada por Management. Vacía = solo módulos core. Prueba local: npm run license:dev -- facilities bookings
CLUMERA_LICENSE=""

# Push web (npm run push:keys -w @clumera/notifications genera un par nuevo).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:soporte@clumera.app"

# Clave pública con la que esta instalación verifica la licencia de Management.
CLUMERA_LICENSE_PUBLIC_KEY=""

# Solo Lab y pruebas: habilita POST /api/push/test (push de prueba sin guardar la suscripción).
CLUMERA_PUSH_TEST=""
