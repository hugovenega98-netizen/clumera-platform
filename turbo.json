{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^generate"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "public/sw.js"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck",
        "^generate",
        "generate"
      ]
    },
    "test": {
      "outputs": [],
      "dependsOn": [
        "^generate",
        "generate"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^generate"
      ]
    },
    "generate": {
      "outputs": [
        "src/generated/**"
      ],
      "inputs": [
        "prisma/schema.prisma",
        "prisma.config.ts"
      ]
    }
  },
  "globalEnv": [
    "CLUMERA_CLIENT_ID",
    "NEXT_PUBLIC_*"
  ],
  "globalPassThroughEnv": [
    "CLUMERA_LICENSE",
    "CLUMERA_LICENSE_PUBLIC_KEY",
    "CLUMERA_PUSH_TEST",
    "VAPID_PRIVATE_KEY",
    "VAPID_SUBJECT",
    "DATABASE_URL",
    "VERCEL_*",
    "NEXT_TELEMETRY_DISABLED",
    "TEST_PG_URL"
  ]
}
