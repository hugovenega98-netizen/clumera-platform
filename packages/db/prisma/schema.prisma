// Clumera 2.0 — esquema de la Fase 0.
// Una base por club (Neon). La Persona es la entidad central: existe una sola vez y todo
// (membresía, roles, deportes, servicios, cargos) se cuelga de ella. La cuenta es opcional.
// Los dominios de Hito A en adelante (deportes, finanzas, agenda, credenciales, inscripciones)
// se agregan en sus propias migraciones.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Identidad ─────────────

model Person {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  /// HMAC del documento normalizado: permite buscar y deduplicar sin guardar el número legible.
  docDigest String?   @unique
  docLast4  String?
  birthDate DateTime? @db.Date
  email     String?
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  account             UserAccount?
  memberships         ClubMembership[]
  roles               RoleAssignment[]
  familyLinks         FamilyRelationship[]
  pickupsAsMinor      PickupAuthorization[] @relation("PickupMinor")
  pickupsAsAuthorized PickupAuthorization[] @relation("PickupAuthorized")
  notifications       Notification[]
  credentials         Credential[]
  charges             Charge[]
  teamMemberships     TeamMember[]
  matchCallups        MatchCallup[]
  absences            Absence[]
  injuryReports       InjuryReport[]
  matchFollows        MatchFollow[]
  bookings            Booking[]
  paymentsMade        Payment[]             @relation("PaymentPayer")

  @@index([lastName, firstName])
  @@index([email])
}

enum AccountStatus {
  pending // creada, sin activar
  active
  locked // bloqueada por intentos fallidos
  disabled
}

model UserAccount {
  id             String        @id @default(cuid())
  personId       String        @unique
  person         Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// Email o usuario, normalizado en minúsculas.
  login          String        @unique
  /// Nulo hasta activar por enlace. Nunca se usa el documento como contraseña.
  passwordHash   String?
  status         AccountStatus @default(pending)
  failedAttempts Int           @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sessions          Session[]
  activationTokens  ActivationToken[]
  pushSubscriptions PushSubscription[]
}

model Session {
  id            String      @id @default(cuid())
  accountId     String
  account       UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// SHA-256 del token de la cookie httpOnly; el token en claro nunca se guarda.
  tokenHash     String      @unique
  /// Espacio activo (socio, deporte, coach, instalaciones…). Cambiarlo no cambia la identidad.
  activeContext String?
  userAgent     String?
  createdAt     DateTime    @default(now())
  lastSeenAt    DateTime    @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  @@index([accountId])
}

enum TokenPurpose {
  activation
  password_reset
}

model ActivationToken {
  id        String       @id @default(cuid())
  accountId String
  account   UserAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  purpose   TokenPurpose
  /// Enlace de un solo uso: se guarda el hash.
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([accountId, purpose])
}

// ───────────── Membresía ─────────────

model MembershipCategory {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  active      Boolean          @default(true)
  /// Cuota social mensual en centavos. Nula: la categoría no paga cuota (vitalicio, honorario).
  monthlyFee  Int?
  memberships ClubMembership[]
}

enum MembershipStatus {
  active
  suspended
  inactive
  resigned
}

model ClubMembership {
  id           String                   @id @default(cuid())
  personId     String
  person       Person                   @relation(fields: [personId], references: [id])
  categoryId   String
  category     MembershipCategory       @relation(fields: [categoryId], references: [id])
  memberNumber String?                  @unique
  status       MembershipStatus         @default(active)
  validFrom    DateTime                 @db.Date
  validTo      DateTime?                @db.Date
  createdAt    DateTime                 @default(now())
  history      MembershipStatusChange[]

  @@index([personId])
}

model MembershipStatusChange {
  id           String            @id @default(cuid())
  membershipId String
  membership   ClubMembership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  fromStatus   MembershipStatus?
  toStatus     MembershipStatus
  reason       String?
  changedById  String?
  changedAt    DateTime          @default(now())

  @@index([membershipId, changedAt])
}

// ───────────── Familia ─────────────

model FamilyGroup {
  id        String               @id @default(cuid())
  name      String
  createdAt DateTime             @default(now())
  members   FamilyRelationship[]
}

enum FamilyRole {
  guardian // responsable
  dependent // representado
  member
}

model FamilyRelationship {
  id       String      @id @default(cuid())
  groupId  String
  group    FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  personId String
  person   Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  role     FamilyRole
  /// madre, padre, tutor, hijo/a…
  relation String?

  @@unique([groupId, personId])
  @@index([personId])
}

model PickupAuthorization {
  id                 String    @id @default(cuid())
  minorId            String
  minor              Person    @relation("PickupMinor", fields: [minorId], references: [id], onDelete: Cascade)
  authorizedPersonId String
  authorizedPerson   Person    @relation("PickupAuthorized", fields: [authorizedPersonId], references: [id], onDelete: Cascade)
  validFrom          DateTime  @default(now())
  validTo            DateTime?
  note               String?

  @@unique([minorId, authorizedPersonId])
}

// ───────────── Roles y permisos ─────────────

model Role {
  code        String           @id
  name        String
  /// Permisos `<modulo>:<accion>`, con comodines y sufijo `:self` (ver @clumera/kernel can()).
  permissions String[]
  /// Roles base del sistema: no se borran desde la interfaz.
  system      Boolean          @default(false)
  assignments RoleAssignment[]
}

enum ScopeType {
  club
  sport
  team
  venue
  resource
  event
  activity
}

model RoleAssignment {
  id        String    @id @default(cuid())
  personId  String
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  roleCode  String
  role      Role      @relation(fields: [roleCode], references: [code])
  scopeType ScopeType
  /// Vacío para alcance `club`. No es nulo para que la restricción única funcione en PostgreSQL.
  scopeId   String    @default("")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@unique([personId, roleCode, scopeType, scopeId])
  @@index([scopeType, scopeId])
}

// ───────────── Plataforma ─────────────

/// Licencia firmada por Management y ya verificada. La fuente de verdad es el token firmado.
model ModuleLicense {
  id        String    @id @default(cuid())
  licenseId String    @unique
  token     String
  modules   String[]
  issuedAt  DateTime
  expiresAt DateTime?
  syncedAt  DateTime  @default(now())
  active    Boolean   @default(true)
}

model PushSubscription {
  id            String      @id @default(cuid())
  accountId     String
  account       UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  endpoint      String      @unique
  p256dh        String
  auth          String
  userAgent     String?
  createdAt     DateTime    @default(now())
  lastSuccessAt DateTime?
  failureCount  Int         @default(0)

  @@index([accountId])
}

model Notification {
  id         String                 @id @default(cuid())
  personId   String
  person     Person                 @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// Módulo o servicio de origen (se muestra en la bandeja).
  source     String
  /// Clave del acontecimiento: evita avisos duplicados por el mismo hecho.
  eventKey   String
  title      String
  body       String
  url        String?
  createdAt  DateTime               @default(now())
  readAt     DateTime?
  deliveries NotificationDelivery[]

  @@unique([personId, eventKey])
  @@index([personId, createdAt])
}

enum DeliveryChannel {
  inbox
  push
  email
}

enum DeliveryStatus {
  pending
  sent
  failed
  skipped
}

model NotificationDelivery {
  id             String          @id @default(cuid())
  notificationId String
  notification   Notification    @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        DeliveryChannel
  status         DeliveryStatus  @default(pending)
  attempts       Int             @default(0)
  lastError      String?
  sentAt         DateTime?

  @@unique([notificationId, channel])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorPersonId String?
  action        String
  entityType    String
  entityId      String
  /// Cambios sin datos clínicos ni documentos en claro.
  diff          Json?
  requestId     String?
  at            DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorPersonId, at])
}

/// Tabla de salida de eventos de dominio: se escribe en la misma transacción que el cambio.
model OutboxEvent {
  id          String    @id
  type        String
  source      String
  payload     Json
  occurredAt  DateTime
  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([publishedAt, occurredAt])
}

/// Idempotencia de consumidores: un evento se procesa una sola vez por consumidor.
model ProcessedEvent {
  consumer    String
  eventId     String
  processedAt DateTime @default(now())

  @@id([consumer, eventId])
}

// ───────────── Seguridad y correo ─────────────

/// Ventana fija de límite de solicitudes, compartida entre instancias serverless.
model RateLimitBucket {
  /// `<regla>:<hash de ip o login>:<inicio de ventana>`; nunca la IP en claro.
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

/// Bandeja de correo de desarrollo y Lab (CLUMERA_MAIL_DRIVER=dev). En producción queda vacía.
model DevMailMessage {
  id        String   @id @default(cuid())
  to        String
  subject   String
  text      String
  html      String?
  tag       String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ───────────── Credenciales ─────────────

enum CredentialKind {
  member_card // carnet social
  pool_pass // pase de pileta (Hito C)
  booking // acceso de una reserva (Hito B)
  ticket // entrada a un evento (Hito D)
  guest // invitado temporal
}

enum CredentialStatus {
  active
  revoked
  expired
}

/// Credencial de acceso. El QR que la representa es un código rotativo (ventanas de 30 s) firmado con
/// `secret`: no contiene datos personales y una captura de pantalla vence enseguida.
model Credential {
  id            String           @id @default(cuid())
  personId      String
  person        Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  kind          CredentialKind
  /// Clave HMAC propia de la credencial (base64url). Revocar la credencial invalida todos sus QR.
  secret        String
  status        CredentialStatus @default(active)
  validFrom     DateTime         @default(now())
  validTo       DateTime?
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime         @default(now())

  @@index([personId, kind, status])
}

// ───────────── Finanzas ─────────────
// Montos en centavos (enteros). Una sola cuenta por persona; la vista del socio suma a sus representados.

enum ChargeStatus {
  pending
  paid
  cancelled
}

/// Lo que se debe: cuota, arancel, reserva, colonia… Cada módulo emite los suyos con `source` + `sourceRef`.
model Charge {
  id              String              @id @default(cuid())
  personId        String
  person          Person              @relation(fields: [personId], references: [id], onDelete: Restrict)
  /// cuota_social, arancel, reserva, colonia, evento, tienda, otro
  concept         String
  /// Agrupador visible en la cuenta: «Membresía social», «Rugby XV», «Servicios».
  groupLabel      String
  description     String
  /// AAAA-MM cuando corresponde a un período.
  period          String?
  amount          Int
  paidAmount      Int                 @default(0)
  dueDate         DateTime            @db.Date
  status          ChargeStatus        @default(pending)
  /// Módulo que lo originó y su referencia: emitir dos veces lo mismo no duplica.
  source          String
  sourceRef       String
  issuedById      String?
  cancelledReason String?
  createdAt       DateTime            @default(now())
  allocations     PaymentAllocation[]

  @@unique([source, sourceRef])
  @@index([personId, status])
  @@index([status, dueDate])
}

enum PaymentMethod {
  cash
  transfer
  card
  mercadopago
}

enum PaymentStatus {
  pending
  approved
  rejected
  refunded
}

/// Un cobro. Los presenciales nacen aprobados; los de la pasarela, pendientes hasta el webhook.
model Payment {
  id            String              @id @default(cuid())
  /// N° de comprobante (R-000123).
  number        Int                 @unique @default(autoincrement())
  payerPersonId String?
  payer         Person?             @relation("PaymentPayer", fields: [payerPersonId], references: [id], onDelete: SetNull)
  amount        Int
  method        PaymentMethod
  status        PaymentStatus       @default(pending)
  provider      String?
  /// Id del pago en la pasarela.
  providerRef   String?
  /// Cargos que este pago quiere cancelar (pagos online: se imputan recién al aprobarse).
  intent        String[]
  note          String?
  recordedById  String?
  receivedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  allocations   PaymentAllocation[]
  events        PaymentEvent[]

  @@unique([provider, providerRef])
  @@index([payerPersonId, createdAt])
  @@index([status, receivedAt])
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  chargeId  String
  charge    Charge  @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  amount    Int

  @@unique([paymentId, chargeId])
  @@index([chargeId])
}

/// Bitácora de un pago: retorno de la pasarela, webhooks (también los duplicados), consultas.
model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  kind      String
  detail    Json?
  at        DateTime @default(now())

  @@index([paymentId, at])
}

// ───────────── Deportes ─────────────
// Los deportes del club salen del catálogo (código); `slug` es el ámbito de los roles
// (sport:<slug>, team:<slug>), el mismo que usa can().

model Sport {
  id        String   @id @default(cuid())
  /// Código del catálogo: rugby_xv, hockey, volleyball…
  code      String
  /// Ámbito de roles: rugby, hockey…
  slug      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  teams     Team[]
}

model Team {
  id            String         @id @default(cuid())
  sportId       String
  sport         Sport          @relation(fields: [sportId], references: [id], onDelete: Restrict)
  name          String
  /// Ámbito de roles: rugby-m19…
  slug          String         @unique
  /// Arancel mensual en centavos (se emite como cargo en Finanzas). Nulo: sin arancel.
  monthlyFee    Int?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  members       TeamMember[]
  matches       Match[]
  absences      Absence[]
  injuryReports InjuryReport[]

  @@unique([sportId, name])
}

/// Jugador en un plantel. Los coaches y la mesa son roles con ámbito, no miembros.
model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  personId String
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  number   Int?
  active   Boolean  @default(true)
  joinedAt DateTime @default(now())

  @@unique([teamId, personId])
  @@index([personId, active])
}

enum MatchStatus {
  scheduled
  live
  /// Silbato final de la mesa; el coach confirma «jugado».
  pending_close
  played
  cancelled
}

model Match {
  id               String                 @id @default(cuid())
  teamId           String
  team             Team                   @relation(fields: [teamId], references: [id], onDelete: Restrict)
  opponent         String
  startsAt         DateTime
  home             Boolean                @default(true)
  venue            String                 @default("")
  status           MatchStatus            @default(scheduled)
  scoreFor         Int?
  scoreAgainst     Int?
  /// Minuto a minuto público (sin sesión). Privado por defecto.
  mamPublic        Boolean                @default(false)
  /// Transmisión: id de video de YouTube (11 caracteres, validado). Se ve donde se ve el minuto a minuto.
  streamVideoId    String?
  createdById      String
  createdAt        DateTime               @default(now())
  events           MatchEvent[]
  clock            MatchClock?
  callups          MatchCallup[]
  guestPasses      MatchGuestPass[]
  follows          MatchFollow[]
  temporaryPlayers MatchTemporaryPlayer[]
  substitutions    MatchSubstitution[]

  @@index([teamId, startsAt])
  @@index([status, startsAt])
}

enum CallupResponse {
  pending
  going
  not_going
}

/// Convocatoria: a quién se cita, qué respondió y si quedó en la formación del partido.
model MatchCallup {
  id          String         @id @default(cuid())
  matchId     String
  match       Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  personId    String
  person      Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  response    CallupResponse @default(pending)
  note        String?
  respondedAt DateTime?
  inLineup    Boolean        @default(false)
  position    String?

  @@unique([matchId, personId])
  @@index([personId])
}

enum MatchSide {
  own
  opponent
}

model MatchEvent {
  id                String                @id @default(cuid())
  matchId           String
  match             Match                 @relation(fields: [matchId], references: [id], onDelete: Cascade)
  personId          String?
  temporaryPlayerId String?
  temporaryPlayer   MatchTemporaryPlayer? @relation(fields: [temporaryPlayerId], references: [id], onDelete: Restrict)
  side              MatchSide             @default(own)
  opponentPlayer    String?
  type              String
  minute            Int?
  setNumber         Int?
  createdById       String
  createdAt         DateTime              @default(now())
  /// Deshacer en la mesa: la incidencia queda anulada, no se borra.
  voidedAt          DateTime?

  @@index([matchId, createdAt])
  @@index([personId, type])
}

model MatchClock {
  matchId        String    @id
  match          Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  phase          String    @default("not_started")
  elapsedSeconds Int       @default(0)
  addedMinutes   Int       @default(0)
  runningSince   DateTime?
  updatedAt      DateTime  @updatedAt
}

/// Ausencia informada por la persona (o su responsable) para una fecha.
model Absence {
  id          String    @id @default(cuid())
  personId    String
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  reason      String
  createdById String
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  @@unique([personId, teamId, date])
  @@index([teamId, date])
}

/// Pase de invitado al minuto a minuto de un partido privado: el código se muestra una sola vez;
/// se guarda su HMAC. No crea cuenta ni da acceso a nada más del club.
model MatchGuestPass {
  id          String    @id @default(cuid())
  matchId     String
  match       Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  codeHash    String    @unique
  codeHint    String
  createdById String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([matchId])
}

/// Quién sigue un partido (avisos push por incidencia). Convocados y sus responsables lo siguen solos.
model MatchFollow {
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([matchId, personId])
}

/// Planilla transitoria: un nombre y un dorsal para ese partido. Sin cuenta, documento ni membresía.
model MatchTemporaryPlayer {
  id        String       @id @default(cuid())
  matchId   String
  match     Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  name      String
  number    Int?
  createdAt DateTime     @default(now())
  events    MatchEvent[]

  @@unique([matchId, number])
}

/// Cambio efectivo: los dos jugaron, ninguno sale de la planilla.
model MatchSubstitution {
  id          String   @id @default(cuid())
  matchId     String
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  outPersonId String
  inPersonId  String
  minute      Int?
  createdById String
  createdAt   DateTime @default(now())

  @@index([matchId])
}

// ───────────── Salud deportiva ─────────────
// Datos clínicos: solo quien tiene sports:health.view asignado por su nombre (Médico/Kine) en el
// ámbito del deporte. La persona ve su reporte y la nota pública; el coach, solo la disponibilidad.

enum InjuryStatus {
  evaluation
  follow_up
  closed
}

enum SportAvailability {
  under_review
  no_restrictions
  restricted
  unavailable
}

model InjuryReport {
  id          String          @id @default(cuid())
  personId    String
  person      Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Restrict)
  zone        String
  /// Dolor 0–10.
  pain        Int
  context     String
  impact      String
  onsetDate   DateTime        @db.Date
  notes       String          @default("")
  createdById String
  createdAt   DateTime        @default(now())
  case        InjuryCase?
  sessions    InjurySession[]

  @@index([teamId, createdAt])
  @@index([personId, createdAt])
}

/// Estado vigente del seguimiento (resumen de la última evaluación).
model InjuryCase {
  reportId     String            @id
  report       InjuryReport      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status       InjuryStatus
  availability SportAvailability
  publicNote   String            @default("")
  privateNote  String            @default("")
  updatedById  String
  updatedAt    DateTime          @updatedAt
}

/// Evaluación inmutable: el historial clínico no se edita.
model InjurySession {
  id           String            @id @default(cuid())
  reportId     String
  report       InjuryReport      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorId     String
  authorName   String
  status       InjuryStatus
  availability SportAvailability
  publicNote   String            @default("")
  privateNote  String            @default("")
  createdAt    DateTime          @default(now())

  @@index([reportId, createdAt])
}

// ───────────── Hito B · Agenda central e Instalaciones ─────────────

enum VenueStatus {
  available
  maintenance
  out_of_service
}

/// Espacio físico del club (cancha, pileta, salón). El estado físico va aparte de la ocupación.
model Venue {
  id         String       @id @default(cuid())
  /// Ámbito para roles: venue:<slug>.
  slug       String       @unique
  name       String
  /// Agrupa en el turnero: «Pádel», «Fútbol 5».
  group      String
  /// «Césped», «40 personas».
  detail     String       @default("")
  status     VenueStatus  @default(available)
  statusNote String       @default("")
  active     Boolean      @default(true)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  slots      AgendaSlot[]
  rule       BookingRule?
  tariffs    Tariff[]
  bookings   Booking[]
}

enum AgendaKind {
  block
  match
  tournament
  event
  school
  booking
}

enum AgendaSlotStatus {
  held
  confirmed
  released
}

/// Ocupación de un espacio en la agenda central. Nunca se superponen dos ocupaciones vigentes
/// (retenidas o confirmadas): lo garantiza la agenda con un bloqueo por espacio en la transacción.
model AgendaSlot {
  id            String           @id @default(cuid())
  venueId       String
  venue         Venue            @relation(fields: [venueId], references: [id], onDelete: Restrict)
  startsAt      DateTime
  endsAt        DateTime
  kind          AgendaKind
  /// Mayor gana: bloqueo > partido > torneo > evento > escuela > reserva.
  priority      Int
  status        AgendaSlotStatus @default(confirmed)
  /// Una retención vence sola: pasada esta hora el turno vuelve a estar libre.
  holdExpiresAt DateTime?
  label         String
  /// Módulo dueño y su referencia (la reserva, el partido…).
  source        String
  sourceRef     String
  createdById   String?
  releasedAt    DateTime?
  createdAt     DateTime         @default(now())
  booking       Booking?

  @@index([venueId, startsAt])
  @@index([status, holdExpiresAt])
  @@index([source, sourceRef])
}

// ───────────── Hito B · Reservas ─────────────

/// Reglas de reserva de un espacio. Sin regla, el espacio no se reserva.
model BookingRule {
  venueId        String   @id
  venue          Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  slotMinutes    Int      @default(60)
  /// Minutos desde las 00:00 (hora del club).
  openFrom       Int      @default(480)
  openTo         Int      @default(1380)
  maxAdvanceDays Int      @default(14)
  holdMinutes    Int      @default(10)
  /// Cancelación sin cargo hasta estas horas antes.
  cancelHours    Int      @default(24)
  /// 0 = sin opción de seña; si no, porcentaje de la seña.
  depositPercent Int      @default(50)
  payAtClub      Boolean  @default(false)
  /// Reserva pública sin cuenta (Hito B, segundo tramo).
  publicBooking  Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

/// Tarifa por franja: días (bit 0 = lunes … bit 6 = domingo) y horario.
model Tariff {
  id          String @id @default(cuid())
  venueId     String
  venue       Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  label       String
  days        Int    @default(127)
  fromMinute  Int
  toMinute    Int
  memberPrice Int
  guestPrice  Int

  @@index([venueId])
}

enum BookingStatus {
  held
  confirmed
  cancelled
  expired
  conflict
}

enum BookingPayMode {
  full
  deposit
  club
}

model Booking {
  id            String         @id @default(cuid())
  venueId       String
  venue         Venue          @relation(fields: [venueId], references: [id], onDelete: Restrict)
  slotId        String?        @unique
  slot          AgendaSlot?    @relation(fields: [slotId], references: [id], onDelete: SetNull)
  personId      String
  person        Person         @relation(fields: [personId], references: [id], onDelete: Restrict)
  startsAt      DateTime
  endsAt        DateTime
  status        BookingStatus  @default(held)
  payMode       BookingPayMode
  /// Precio total y lo que se cobra al reservar (todo, la seña o nada si se paga en el club).
  price         Int
  chargeAmount  Int
  memberRate    Boolean
  chargeId      String?
  holdExpiresAt DateTime?
  /// Pagó algo y canceló a tiempo: Contabilidad gestiona el reintegro.
  refundDue     Int            @default(0)
  cancelledAt   DateTime?
  cancelReason  String?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([personId, startsAt])
  @@index([venueId, startsAt])
  @@index([status, holdExpiresAt])
}
