{
  "name": "clumera-platform",
  "private": true,
  "version": "2.0.0-alpha.0",
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "packages/modules/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@clumera/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test",
    "check:deps": "node tooling/check-dependency-rules.mjs",
    "check": "npm run check:deps && npm run lint && npm run typecheck && npm run test",
    "license:dev": "tsx tooling/dev-license.ts",
    "test:db:prepare": "node tooling/prepare-test-databases.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.15.0",
    "eslint": "^10.15.0",
    "globals": "^16.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@serwist/build": {
      "zod": "^4.6.7"
    },
    "@serwist/turbopack": {
      "zod": "^4.6.7"
    }
  }
}
